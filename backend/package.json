{
  "name": "industry4-quality-inspection-backend",
  "version": "1.0.0",
  "description": "Industry 4.0 Visual Quality Control Central Telemetry & Management Hub",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "security:check": "npm audit --audit-level=high",
    "test": "node --test dist/tests/*.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "industry4",
    "defect-detection",
    "edge-ai",
    "quality-assurance",
    "onnx"
  ],
  "author": "Industry 4.0 Inspection Team",
  "license": "UNLICENSED",
